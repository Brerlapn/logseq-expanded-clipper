{
  "manifest_version": 3,
  "name": "Logseq Expanded Clipper",
  "version": "1.4.1",
  "key": "",
  "description": "Capture the page you're reading into your Logseq DB graph: URL, title, tags, notes, highlight.",
  "browser_specific_settings": {
    "gecko": {
      "id": "logseqexpandedclipper@brerlapn.org",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": []
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "background/service-worker.js"
    ],
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "commands": {
    "open-modal": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Open Logseq Expanded Clipper"
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Logseq Expanded Clipper (Alt+Shift+L)"
  }
}
